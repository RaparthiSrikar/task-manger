# ── Server ────────────────────────────────────────────────
PORT=3001
# Comma-separated list of allowed origins for CORS (your deployed frontend URL)
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────
# Local: mongodb://localhost:27017/task-manager
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/task-manager
MONGODB_URI=mongodb://localhost:27017/task-manager

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Email (SMTP) ──────────────────────────────────────────
# Works with any SMTP provider: Gmail (use an App Password), SendGrid SMTP,
# Resend SMTP, Mailtrap (for testing), etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Task Manager <no-reply@taskmanager.com>"

# ── File upload (Cloudinary) ─────────────────────────────
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Weather (OpenWeatherMap) ──────────────────────────────
# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=
